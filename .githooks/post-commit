#!/bin/sh
# Post-commit must never create another commit or rewrite tracked documents.
root=$(git rev-parse --show-toplevel) || exit 0
if ! python3 "$root/tools/endermend-context/context.py" capture; then
    printf '%s\n' 'WARNING: commit succeeded, but context checkpoint failed. Run context.py capture.' >&2
fi
# Only the chat explicitly bound by the owner; never discover unrelated sessions.
if [ -f "$root/.context-local/session-path" ]; then
    IFS= read -r session < "$root/.context-local/session-path"
    python3 "$root/tools/endermend-context/context.py" archive-chat "$session" ||
        printf '%s\n' 'WARNING: chat archive failed; commit remains successful.' >&2
fi
exit 0
