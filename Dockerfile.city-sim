ARG CITY_SIM_MODEL_SOURCE=remote-model
FROM python:3.12-slim AS remote-model
ADD https://github.com/NDaVS/kamcha-snow-sim.git#087118ff9119eaa211fa19e89251b73f232406da /model

FROM python:3.12-slim AS local-model
COPY city_sim/.state/danil/snowmap/*.py /model/snowmap/
COPY city_sim/.state/danil/kernels/*.json /model/kernels/

FROM ${CITY_SIM_MODEL_SOURCE} AS snow-model
COPY city_sim/data/snow-engine-lock.json /snow-engine-lock.json
RUN python - <<'PYTHON'
from hashlib import sha256
import json
from pathlib import Path

lock = json.loads(Path("/snow-engine-lock.json").read_text())
for path, checksum in lock["sha256"].items():
    contents = (Path("/model") / path).read_bytes()
    if sha256(contents).hexdigest() != checksum:
        raise ValueError(f"Unexpected checksum: {path}")
    destination = Path("/danil") / path
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_bytes(contents)
PYTHON

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 CITY_SIM_DANIL=/danil
COPY requirements-city-sim.txt ./
RUN pip install --no-cache-dir --timeout 40 -r requirements-city-sim.txt
COPY city_sim/*.py ./city_sim/
COPY city_sim/data ./city_sim/data
COPY snowops ./snowops
COPY winter_audit/__init__.py winter_audit/relief.py ./winter_audit/
COPY weather_coverage/__init__.py weather_coverage/geography.py weather_coverage/heatmap_fields.py weather_coverage/heatmap_interpolate.py ./weather_coverage/
COPY weather_coverage/osm ./weather_coverage/osm
COPY data/pkc ./data/pkc
COPY --from=snow-model /danil /danil
EXPOSE 8008
CMD ["python", "-m", "city_sim"]
