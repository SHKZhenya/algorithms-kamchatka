# Настройки камер находятся в cameras.json

# Optional shared Weather VLM v2 endpoint. Enable only for an authorized model service.
SCENE_MODEL_URL=

# Server-side Yandex Weather API key for the hourly forecast and current weather.
# Load the repository .env with --env-file ../../../.env.
X-Yandex-Weather-Key=

# Optional server delivery. Recipient must deduplicate Idempotency-Key.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
