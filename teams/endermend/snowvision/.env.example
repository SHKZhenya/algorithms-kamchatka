# Настройки камер: backend/snowvision/resources/cameras.json

# Local camera vision model. External /v2/scene compatibility: provider=weather_vlm.
SCENE_MODEL_URL=http://vision:11434
SCENE_MODEL_PROVIDER=ollama
SCENE_MODEL_NAME=gemma3:4b
SNOWVISION_MODEL_DIR=/mnt/disk_d/Development/kam4atka/snowvision-models

# Temporary city-index switch: set true to exclude cameras without a confirmed city view.
SNOWVISION_REQUIRE_VERIFIED_CITY_VIEW=false

# Server-side Yandex Weather API key for the hourly forecast and current weather.
# Load the repository .env with --env-file ../../../.env.
X-Yandex-Weather-Key=

# Optional server delivery. Recipient must deduplicate Idempotency-Key.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
