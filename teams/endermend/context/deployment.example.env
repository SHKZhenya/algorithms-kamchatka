# Copy to deployment.local.env and fill in locally. No credentials in this file.
# SSH target may be an alias defined in ~/.ssh/config.
DEPLOY_SSH_TARGET='server-alias'
DEPLOY_ADDRESS='example.invalid'
DEPLOY_SSH_USER='deploy-user'
DEPLOY_ROOT='/path/to/deployment'
DEPLOY_RELEASE_DIR='/path/to/deployment/releases/current'
DEPLOY_ENV_FILE='/path/to/private/environment-file'
DEPLOY_OVERRIDE_FILE='/path/to/deployment/releases/current/compose.override.yaml'
DEPLOY_COMPOSE_PROJECT='project-name'
DEPLOY_HISTORY_VOLUME='existing-history-volume'
DEPLOY_PREVIOUS_RELEASE_DIR='/path/to/deployment/releases/previous'
